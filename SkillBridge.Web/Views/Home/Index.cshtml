@model HomeViewModel
@{
    ViewData["Title"] = "Find your next opportunity";
}

<section class="hero rounded-4 p-4 p-md-5 mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="badge text-bg-light text-primary mb-3">Careers made simpler</span>
            <h1 class="display-5 fw-bold">Build the bridge to your next opportunity.</h1>
            <p class="lead mb-4">Discover roles from growing companies, apply with confidence, and track every application in one place.</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-light btn-lg" asp-controller="Jobs" asp-action="Index">Browse jobs</a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Register">Join SkillBridge</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="hero-panel rounded-4 p-4">
                <h2 class="h4">For companies</h2>
                <p>Publish vacancies, manage candidates, and keep hiring decisions organized.</p>
                <a class="link-light fw-semibold" asp-controller="Account" asp-action="Register">Create a company account →</a>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div><p class="text-primary fw-semibold mb-1">Latest openings</p><h2 class="h3 mb-0">Jobs worth exploring</h2></div>
        <a asp-controller="Jobs" asp-action="Index">View all jobs</a>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="alert alert-warning">@Model.Notice</div>
    }
    @if (Model.RecentJobs.Count == 0)
    {
        <div class="empty-state">No active jobs are available yet.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var job in Model.RecentJobs)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card job-card h-100"><div class="card-body">
                        <span class="badge text-bg-light mb-2">@job.JobType</span>
                        <h3 class="h5"><a class="stretched-link text-decoration-none" asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id">@job.Title</a></h3>
                        <p class="text-secondary mb-2">@job.CompanyName</p><p class="mb-0">@job.Location</p>
                    </div></article>
                </div>
            }
        </div>
    }
</section>
