@model ApplicantDashboardViewModel
@{ ViewData["Title"] = "Applicant dashboard"; }
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4"><div><p class="text-primary fw-semibold mb-1">Applicant dashboard</p><h1 class="h2 mb-0">Your application activity</h1></div><a class="btn btn-primary" asp-controller="Jobs" asp-action="Index">Find jobs</a></div>
<div class="row g-3 mb-5">
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Total</span><strong>@Model.TotalApplications</strong></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Pending</span><strong>@Model.PendingApplications</strong></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Shortlisted</span><strong>@Model.ShortlistedApplications</strong></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><span>Rejected</span><strong>@Model.RejectedApplications</strong></div></div>
</div>
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Recent applications</h2><a asp-action="Applications">View all</a></div>
@if (Model.RecentApplications.Count == 0)
{
    <div class="empty-state">You have not applied to any jobs yet.</div>
}
else
{
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Job</th><th>Company</th><th>Applied</th><th>Status</th></tr></thead><tbody>
    @foreach (var application in Model.RecentApplications)
    {
        <tr><td><a asp-controller="Jobs" asp-action="Details" asp-route-id="@application.JobId">@application.JobTitle</a></td><td>@application.CompanyName</td><td>@application.AppliedDate.ToLocalTime().ToString("MMM d, yyyy")</td><td><span class="status status-@application.Status.ToLowerInvariant()">@application.Status</span></td></tr>
    }
    </tbody></table></div>
}
