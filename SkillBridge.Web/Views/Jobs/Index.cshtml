@model JobListViewModel
@{ ViewData["Title"] = "Browse jobs"; }
<div class="mb-4"><h1 class="h2">Browse jobs</h1><p class="text-secondary">Search active opportunities by keyword, location, or job type.</p></div>
<form method="get" class="card card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4"><label for="search" class="form-label">Keyword</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Title or description" /></div>
        <div class="col-md-3"><label for="location" class="form-label">Location</label><input id="location" name="location" value="@Model.Location" class="form-control" placeholder="City or remote" /></div>
        <div class="col-md-3"><label for="jobType" class="form-label">Job type</label><input id="jobType" name="jobType" value="@Model.JobType" class="form-control" placeholder="Full-time" /></div>
        <div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Search</button></div>
    </div>
</form>
<p class="text-secondary">@Model.TotalRecords active job@(Model.TotalRecords == 1 ? "" : "s") found</p>
@if (Model.Jobs.Count == 0)
{
    <div class="empty-state text-center"><h2 class="h4">No matching jobs</h2><p class="mb-3">Try changing or clearing the filters.</p><a class="btn btn-outline-primary" asp-action="Index">Clear filters</a></div>
}
else
{
    <div class="row g-3">
        @foreach (var job in Model.Jobs)
        {
            <div class="col-md-6 col-lg-4"><article class="card job-card h-100"><div class="card-body d-flex flex-column">
                <div><span class="badge text-bg-light mb-2">@job.JobType</span><h2 class="h5">@job.Title</h2><p class="text-secondary mb-2">@job.CompanyName</p><p class="mb-1">@job.Location</p><p>@job.MinimumSalary.ToString("N0") – @job.MaximumSalary.ToString("N0")</p></div>
                <div class="mt-auto d-flex justify-content-between align-items-center"><small class="text-secondary">Closes @job.Deadline.ToLocalTime().ToString("MMM d")</small><a class="btn btn-sm btn-outline-primary stretched-link" asp-action="Details" asp-route-id="@job.Id">Details</a></div>
            </div></article></div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Job result pages"><ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")"><a class="page-link" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-location="@Model.Location" asp-route-jobType="@Model.JobType">Previous</a></li>
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")"><a class="page-link" asp-route-page="@pageNumber" asp-route-search="@Model.Search" asp-route-location="@Model.Location" asp-route-jobType="@Model.JobType">@pageNumber</a></li>
            }
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"><a class="page-link" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-location="@Model.Location" asp-route-jobType="@Model.JobType">Next</a></li>
        </ul></nav>
    }
}
