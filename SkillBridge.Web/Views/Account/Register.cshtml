@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<div class="auth-card card mx-auto shadow-sm"><div class="card-body p-4 p-md-5">
    <h1 class="h3">Create your SkillBridge account</h1>
    <p class="text-secondary">Choose the account type that matches how you will use the platform.</p>
    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" autocomplete="name" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Type" class="form-label">Account type</label><select asp-for="Type" class="form-select"><option value="Applicant">Applicant</option><option value="Company">Company</option></select><span asp-validation-for="Type" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button class="btn btn-primary w-100" type="submit">Create account</button>
    </form>
    <p class="text-center mt-3 mb-0">Already registered? <a asp-action="Login">Sign in</a></p>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
