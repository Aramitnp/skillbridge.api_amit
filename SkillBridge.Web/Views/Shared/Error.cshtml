@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }

<div class="empty-state mx-auto text-center">
    <h1 class="h3">We could not complete your request.</h1>
    <p class="text-secondary">Please return to Elevate Workforce Solutions and try again.</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Return Home</a>
</div>
