@model IReadOnlyList<JobApplicationViewModel>
@{ ViewData["Title"] = "Job applications"; var jobId = (int)(ViewData["JobId"] ?? 0); }
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4"><div><p class="text-primary fw-semibold mb-1">Company area</p><h1 class="h2 mb-0">Applications for this job</h1></div><a class="btn btn-outline-secondary" asp-action="MyJobs">Back to my jobs</a></div>
@if (Model.Count == 0)
{
    <div class="empty-state">No one has applied to this job yet.</div>
}
else
{
    <div class="table-responsive card"><table class="table align-middle mb-0"><thead><tr><th>Applicant</th><th>Applied</th><th>Cover letter</th><th>Status</th></tr></thead><tbody>
    @foreach (var application in Model)
    {
        <tr><td><strong>@application.ApplicantName</strong><br /><small>@application.ApplicantEmail</small></td><td>@application.AppliedDate.ToLocalTime().ToString("MMM d, yyyy")</td><td><details><summary>Read</summary><p class="mt-2 application-letter">@application.CoverLetter</p></details></td><td>
            <form asp-action="UpdateStatus" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@application.Id" /><input type="hidden" name="jobId" value="@jobId" /><select name="status" class="form-select form-select-sm" aria-label="Status for @application.ApplicantName"><option selected="@(application.Status == "Pending")">Pending</option><option selected="@(application.Status == "Reviewed")">Reviewed</option><option selected="@(application.Status == "Shortlisted")">Shortlisted</option><option selected="@(application.Status == "Rejected")">Rejected</option><option selected="@(application.Status == "Accepted")">Accepted</option></select><button class="btn btn-sm btn-outline-primary" type="submit">Save</button></form>
        </td></tr>
    }
    </tbody></table></div>
}
